# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pre-launch: hide sign-in/sign-up and show waitlist CTAs only
NEXT_PUBLIC_WAITLIST_MODE=false

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/soyupwork?schema=public"

# -----------------------------------------------------------------------------
# AUTH.JS (NextAuth v5)
# -----------------------------------------------------------------------------

# Generate with: openssl rand -base64 32
AUTH_SECRET=

AUTH_URL=http://localhost:3000

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Magic link sign-in (Resend). Falls back to RESEND_API_KEY if unset.
AUTH_RESEND_KEY=

# Optional client-visible redirect after sign-out
NEXT_PUBLIC_AUTH_SIGN_OUT_URL=/
AUTH_SIGN_OUT_URL=/

# -----------------------------------------------------------------------------
# STRIPE
# -----------------------------------------------------------------------------

STRIPE_SECRET_KEY=sk_test
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test

STRIPE_WEBHOOK_SECRET=whsec

# Optional
STRIPE_CURRENCY=usd

# -----------------------------------------------------------------------------
# RESEND
# -----------------------------------------------------------------------------

RESEND_API_KEY=re

EMAIL_FROM="soyup.work <noreply@nicotordev.com>"
EMAIL_SUPPORT=noreply@nicotordev.com

# -----------------------------------------------------------------------------
# CLOUDFLARE TURNSTILE (bot protection — waitlist, etc.)
# -----------------------------------------------------------------------------

# Site key (public, widget) + secret key (server siteverify)
# https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Set to "true" to enable Turnstile in local development (skipped by default).
NEXT_PUBLIC_TURNSTILE_ENABLE_DEV=false

# -----------------------------------------------------------------------------
# WAITLIST (email verification + Resend audience)
# -----------------------------------------------------------------------------

# Segment ID for verified waitlist contacts in Resend (Contacts → Segments).
# Create or resolve it with: bun run resend:waitlist-segment
RESEND_WAITLIST_SEGMENT_ID=

# Secret used to hash waitlist OTP codes and invite tokens (min. 32 random chars recommended).
# Required for waitlist OTP hashing and invite links in production.
# Optional override for invite-only signing: WAITLIST_INVITE_SECRET=
WAITLIST_VERIFICATION_SECRET=

# -----------------------------------------------------------------------------
# CLOUDFLARE R2
# -----------------------------------------------------------------------------

R2_ACCOUNT_ID=

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

R2_BUCKET=
R2_PUBLIC_URL=

R2_ENDPOINT=

# Optional
R2_REGION=auto

# -----------------------------------------------------------------------------
# VIDEO
# -----------------------------------------------------------------------------

# If using Mux
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# DEMO COURSE (/demo)
# -----------------------------------------------------------------------------

# Published course slug for /demo when set; otherwise the latest published course is used.
DEMO_COURSE_SLUG=

# Mux playback IDs for demo lesson videos (create with: bun run demo:mux-videos)
# DEMO_VIDEO_PLAYBACK_ID is a legacy fallback for the welcome lesson only.
DEMO_VIDEO_PLAYBACK_ID=
DEMO_VIDEO_WELCOME_PLAYBACK_ID=
DEMO_VIDEO_JOB_SELECTION_PLAYBACK_ID=
DEMO_VIDEO_PROFILE_AUDIT_PLAYBACK_ID=
DEMO_VIDEO_PROPOSAL_STRUCTURE_PLAYBACK_ID=
DEMO_VIDEO_INTERVIEW_PLAYBACK_ID=
DEMO_VIDEO_ONBOARDING_PLAYBACK_ID=

# Script demo:mux-videos uses Mux test assets by default; set to "false" to upload real files.
DEMO_MUX_TEST_ASSETS=

# Keep raw analytics events for internal product analytics.
ANALYTICS_RETENTION_DAYS=365

# Keep logs shorter to avoid DB bloat.
LOG_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# LOGGING LEVEL
# -----------------------------------------------------------------------------

LOG_LEVEL=info

# Optional browser log level (defaults to LOG_LEVEL, or warn in production).
# NEXT_PUBLIC_LOG_LEVEL=debug

# Set to "false" to stop forwarding warn/error/fatal from the browser to POST /api/log.
# NEXT_PUBLIC_LOG_REMOTE=true

# Client log ingest (/api/log) — requires signed-in user when true (default).
# LOG_INGEST_REQUIRE_AUTH=true
# LOG_INGEST_MAX_BODY_BYTES=16384
# LOG_INGEST_RATE_LIMIT_PER_MINUTE=60

# Valid values:
# trace
# debug
# info
# warn
# error
# fatal

# -----------------------------------------------------------------------------
# INNGEST
# -----------------------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------

CRON_SECRET=
INTERNAL_API_SECRET=

# -----------------------------------------------------------------------------
# UPLOAD LIMITS
# -----------------------------------------------------------------------------

MAX_VIDEO_SIZE_MB=5000
MAX_FILE_SIZE_MB=100

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------

RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# OPTIONAL REDIS
# -----------------------------------------------------------------------------

REDIS_URL=redis://localhost:6379


# -----------------------------------------------------------------------------
# AI - OPENAI
# -----------------------------------------------------------------------------

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini

# -----------------------------------------------------------------------------
# ADMIN
# -----------------------------------------------------------------------------

# Comma-separated exact emails and/or domains (prefix with @)
ADMIN_EMAILS=nicotordev@gmail.com,@soyup.work
